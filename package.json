{
  "name": "vertical-tabs-inside-editor-area",
  "displayName": "Vertical Tabs Inside Editor Area",
  "description": "A vertical tab navigator locked inside the editor area. Shows all tabs across VS Code editor groups with grouping, pinning, drag-and-drop, sorting, and multi-language support.",
  "version": "0.18.3",
  "publisher": "laikang287",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laikang287/vscode-vertical-tabs-inside-editor-area"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:verticalTabs.open",
    "onWebviewPanel:verticalTabs.editorArea"
  ],
  "contributes": {
    "commands": [
      {
        "command": "verticalTabs.open",
        "title": "%verticalTabs.command.open%"
      },
      {
        "command": "verticalTabs.toggle",
        "title": "Vertical Tabs: Toggle"
      },
      {
        "command": "verticalTabs.close",
        "title": "%verticalTabs.command.close%"
      },
      {
        "command": "verticalTabs.focus",
        "title": "Vertical Tabs: Focus"
      },
      {
        "command": "verticalTabs.previous",
        "title": "Vertical Tabs: Previous Tab"
      },
      {
        "command": "verticalTabs.next",
        "title": "Vertical Tabs: Next Tab"
      },
      {
        "command": "verticalTabs.previousInGroup",
        "title": "%verticalTabs.command.previousInGroup%"
      },
      {
        "command": "verticalTabs.nextInGroup",
        "title": "%verticalTabs.command.nextInGroup%"
      },
      {
        "command": "verticalTabs.previousAcrossGroups",
        "title": "%verticalTabs.command.previousAcrossGroups%"
      },
      {
        "command": "verticalTabs.nextAcrossGroups",
        "title": "%verticalTabs.command.nextAcrossGroups%"
      },
      {
        "command": "verticalTabs.moveUpInGroup",
        "title": "%verticalTabs.command.moveUpInGroup%"
      },
      {
        "command": "verticalTabs.moveDownInGroup",
        "title": "%verticalTabs.command.moveDownInGroup%"
      },
      {
        "command": "verticalTabs.moveToPreviousGroup",
        "title": "%verticalTabs.command.moveToPreviousGroup%"
      },
      {
        "command": "verticalTabs.moveToNextGroup",
        "title": "%verticalTabs.command.moveToNextGroup%"
      },
      {
        "command": "verticalTabs.showLogs",
        "title": "Vertical Tabs: Show Logs"
      }
    ],
    "keybindings": [
      {
        "command": "verticalTabs.focus",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "configuration": {
      "title": "Vertical Tabs",
      "properties": {
        "verticalTabs.position": {
          "type": "string",
          "default": "left",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.position.left%",
            "%verticalTabs.config.position.right%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.position%"
        },
        "verticalTabs.rememberState": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.rememberState%"
        },
        "verticalTabs.tabWidthRatio": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.1,
          "maximum": 0.5,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.tabWidthRatio%"
        },
        "verticalTabs.relativePathDisplay": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "duplicatesDirectory",
            "duplicates",
            "alwaysDirectory",
            "always"
          ],
          "enumItemLabels": [
            "%verticalTabs.config.relativePathDisplay.label.off%",
            "%verticalTabs.config.relativePathDisplay.label.duplicatesDirectory%",
            "%verticalTabs.config.relativePathDisplay.label.duplicates%",
            "%verticalTabs.config.relativePathDisplay.label.alwaysDirectory%",
            "%verticalTabs.config.relativePathDisplay.label.always%"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.relativePathDisplay.off%",
            "%verticalTabs.config.relativePathDisplay.duplicatesDirectory%",
            "%verticalTabs.config.relativePathDisplay.duplicates%",
            "%verticalTabs.config.relativePathDisplay.alwaysDirectory%",
            "%verticalTabs.config.relativePathDisplay.always%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.relativePathDisplay%"
        },
        "verticalTabs.defaultGroupMode": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "manual",
            "parentDir",
            "fileType"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.defaultGroupMode.vscode%",
            "%verticalTabs.config.defaultGroupMode.manual%",
            "%verticalTabs.config.defaultGroupMode.parentDir%",
            "%verticalTabs.config.defaultGroupMode.fileType%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultGroupMode%"
        },
        "verticalTabs.defaultSortMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "mru",
            "modifiedAsc",
            "modifiedDesc",
            "nameAsc",
            "nameDesc"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.defaultSortMode.none%",
            "%verticalTabs.config.defaultSortMode.mru%",
            "%verticalTabs.config.defaultSortMode.modifiedAsc%",
            "%verticalTabs.config.defaultSortMode.modifiedDesc%",
            "%verticalTabs.config.defaultSortMode.nameAsc%",
            "%verticalTabs.config.defaultSortMode.nameDesc%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultSortMode%"
        },
        "verticalTabs.defaultToolbarControlsVisible": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultToolbarControlsVisible%"
        },
        "verticalTabs.alwaysFollowActiveTab": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.alwaysFollowActiveTab%"
        },
        "verticalTabs.toolbarPosition": {
          "type": "string",
          "default": "top",
          "enum": [
            "top",
            "bottom"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.toolbarPosition.top%",
            "%verticalTabs.config.toolbarPosition.bottom%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.toolbarPosition%"
        },
        "verticalTabs.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "zh-tw",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "pt-br",
            "ru"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.language.auto%",
            "%verticalTabs.config.language.en%",
            "%verticalTabs.config.language.zh-cn%",
            "%verticalTabs.config.language.zh-tw%",
            "%verticalTabs.config.language.ja%",
            "%verticalTabs.config.language.ko%",
            "%verticalTabs.config.language.de%",
            "%verticalTabs.config.language.fr%",
            "%verticalTabs.config.language.es%",
            "%verticalTabs.config.language.pt-br%",
            "%verticalTabs.config.language.ru%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.language%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertical-tabs-activitybar",
          "title": "Vertical Tabs",
          "icon": "media/vertical-tabs.svg"
        }
      ]
    },
    "views": {
      "vertical-tabs-activitybar": [
        {
          "id": "verticalTabs.launcher",
          "name": "Vertical Tabs",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verticalTabs.launcher",
        "when": "!verticalTabs.visible",
        "contents": "%verticalTabs.launcher.show%"
      },
      {
        "view": "verticalTabs.launcher",
        "when": "verticalTabs.visible",
        "contents": "%verticalTabs.launcher.hide%"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "npm run check-types && node scripts/build.mjs",
    "check-types": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile --silent && node scripts/run-integration-tests.mjs",
    "test:displays": "node scripts/list-test-displays.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "package": "node scripts/package.mjs",
    "check:vsix": "node scripts/check-vsix.mjs",
    "verify": "npm run compile && npm test && npm run package && npm run check:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.125.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "glob": "^11.0.2",
    "mocha": "^11.2.2",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "yauzl": "^3.4.0"
  },
  "icon": "media/icon.png",
  "keywords": [
    "vertical tabs",
    "vertical tab",
    "vertical tab bar",
    "vertical editor tabs",
    "vertical file tabs",
    "editor area tabs",
    "inside editor area",
    "inside editor",
    "editor tabs",
    "file tabs",
    "document tabs",
    "open tabs",
    "open editors",
    "tab manager",
    "tab management",
    "tab navigator",
    "tab navigation",
    "tab organizer",
    "tab groups",
    "tab grouping",
    "tab tree",
    "tree tabs",
    "tab pinning",
    "pinned tabs",
    "tab sorting",
    "tab switching",
    "drag and drop tabs",
    "editor groups",
    "always visible tabs",
    "edge vertical tabs"
  ],
  "bugs": {
    "url": "https://github.com/laikang287/vscode-vertical-tabs-inside-editor-area/issues"
  },
  "homepage": "https://github.com/laikang287/vscode-vertical-tabs-inside-editor-area#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
