{
  "name": "vertical-tabs-in-editor-area",
  "displayName": "Vertical Tabs in Editor Area",
  "description": "A synchronized vertical tab navigator hosted in the VS Code editor area.",
  "version": "0.1.66",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/local/vertical-tabs-in-editor-area.git"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:verticalTabs.open",
    "onWebviewPanel:verticalTabs.editorArea"
  ],
  "contributes": {
    "commands": [
      {
        "command": "verticalTabs.open",
        "title": "Vertical Tabs: Open"
      },
      {
        "command": "verticalTabs.toggle",
        "title": "Vertical Tabs: Toggle"
      },
      {
        "command": "verticalTabs.close",
        "title": "Vertical Tabs: Close"
      },
      {
        "command": "verticalTabs.focus",
        "title": "Vertical Tabs: Focus"
      },
      {
        "command": "verticalTabs.previous",
        "title": "Vertical Tabs: Previous Tab"
      },
      {
        "command": "verticalTabs.next",
        "title": "Vertical Tabs: Next Tab"
      },
      {
        "command": "verticalTabs.showLogs",
        "title": "Vertical Tabs: Show Logs"
      }
    ],
    "keybindings": [
      {
        "command": "verticalTabs.focus",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "configuration": {
      "title": "Vertical Tabs",
      "properties": {
        "verticalTabs.rememberState": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "是否自动记忆垂直标签栏状态。开启时按工作区记忆分组方式、排序方式、手工分组和固定分组，并按用户记忆调整后的宽度；关闭时不读取或写入这些状态，始终使用默认值。"
        },
        "verticalTabs.tabWidthRatio": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.1,
          "maximum": 0.5,
          "scope": "window",
          "markdownDescription": "标签页宽度百分比。控制垂直标签栏首次显示或关闭自动记忆时占编辑器区域的宽度比例，默认 20%。"
        },
        "verticalTabs.defaultGroupMode": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "manual",
            "parentDir",
            "fileType"
          ],
          "enumDescriptions": [
            "跟随 VS Code 编辑器组。",
            "使用手工分组。",
            "按父目录分组。",
            "按文件类型分组。"
          ],
          "scope": "window",
          "markdownDescription": "默认分组方式。关闭自动记忆时始终使用该值；开启自动记忆时仅在没有已记忆值时使用。"
        },
        "verticalTabs.defaultSortMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "modifiedAsc",
            "modifiedDesc",
            "nameAsc",
            "nameDesc"
          ],
          "enumDescriptions": [
            "手工排序，可通过拖拽调整标签顺序。",
            "按修改时间升序。",
            "按修改时间降序。",
            "按名称升序。",
            "按名称降序。"
          ],
          "scope": "window",
          "markdownDescription": "默认排序方式。默认为手工排序；关闭自动记忆时始终使用该值，开启自动记忆时仅在没有已记忆值时使用。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertical-tabs-activitybar",
          "title": "Vertical Tabs",
          "icon": "media/vertical-tabs.svg"
        }
      ]
    },
    "views": {
      "vertical-tabs-activitybar": [
        {
          "id": "verticalTabs.launcher",
          "name": "Vertical Tabs",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verticalTabs.launcher",
        "when": "!verticalTabs.visible",
        "contents": "[显示垂直标签页](command:verticalTabs.open)"
      },
      {
        "view": "verticalTabs.launcher",
        "when": "verticalTabs.visible",
        "contents": "[关闭垂直标签页](command:verticalTabs.close)"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "npm run check-types && node scripts/build.mjs",
    "check-types": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile --silent && node scripts/run-integration-tests.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "package": "node scripts/package.mjs",
    "check:vsix": "node scripts/check-vsix.mjs",
    "verify": "npm run compile && npm test && npm run package && npm run check:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "glob": "^11.0.2",
    "mocha": "^11.2.2",
    "typescript": "^5.8.3",
    "yauzl": "^3.4.0"
  }
}
