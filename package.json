{
  "name": "vertical-tabs-in-editor-area",
  "displayName": "Vertical Tabs in Editor Area",
  "description": "A synchronized vertical tab navigator hosted in the VS Code editor area.",
  "version": "0.1.81",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/local/vertical-tabs-in-editor-area.git"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:verticalTabs.open",
    "onWebviewPanel:verticalTabs.editorArea"
  ],
  "contributes": {
    "commands": [
      {
        "command": "verticalTabs.open",
        "title": "Vertical Tabs: Open"
      },
      {
        "command": "verticalTabs.toggle",
        "title": "Vertical Tabs: Toggle"
      },
      {
        "command": "verticalTabs.close",
        "title": "Vertical Tabs: Close"
      },
      {
        "command": "verticalTabs.focus",
        "title": "Vertical Tabs: Focus"
      },
      {
        "command": "verticalTabs.previous",
        "title": "Vertical Tabs: Previous Tab"
      },
      {
        "command": "verticalTabs.next",
        "title": "Vertical Tabs: Next Tab"
      },
      {
        "command": "verticalTabs.showLogs",
        "title": "Vertical Tabs: Show Logs"
      }
    ],
    "keybindings": [
      {
        "command": "verticalTabs.focus",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "configuration": {
      "title": "Vertical Tabs",
      "properties": {
        "verticalTabs.rememberState": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.rememberState%"
        },
        "verticalTabs.tabWidthRatio": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.1,
          "maximum": 0.5,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.tabWidthRatio%"
        },
        "verticalTabs.defaultGroupMode": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "manual",
            "parentDir",
            "fileType"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.defaultGroupMode.vscode%",
            "%verticalTabs.config.defaultGroupMode.manual%",
            "%verticalTabs.config.defaultGroupMode.parentDir%",
            "%verticalTabs.config.defaultGroupMode.fileType%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultGroupMode%"
        },
        "verticalTabs.defaultSortMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "modifiedAsc",
            "modifiedDesc",
            "nameAsc",
            "nameDesc"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.defaultSortMode.none%",
            "%verticalTabs.config.defaultSortMode.modifiedAsc%",
            "%verticalTabs.config.defaultSortMode.modifiedDesc%",
            "%verticalTabs.config.defaultSortMode.nameAsc%",
            "%verticalTabs.config.defaultSortMode.nameDesc%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultSortMode%"
        },
        "verticalTabs.defaultToolbarControlsVisible": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.defaultToolbarControlsVisible%"
        },
        "verticalTabs.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "zh-tw",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "pt-br",
            "ru"
          ],
          "enumDescriptions": [
            "%verticalTabs.config.language.auto%",
            "%verticalTabs.config.language.en%",
            "%verticalTabs.config.language.zh-cn%",
            "%verticalTabs.config.language.zh-tw%",
            "%verticalTabs.config.language.ja%",
            "%verticalTabs.config.language.ko%",
            "%verticalTabs.config.language.de%",
            "%verticalTabs.config.language.fr%",
            "%verticalTabs.config.language.es%",
            "%verticalTabs.config.language.pt-br%",
            "%verticalTabs.config.language.ru%"
          ],
          "scope": "window",
          "markdownDescription": "%verticalTabs.config.language%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertical-tabs-activitybar",
          "title": "Vertical Tabs",
          "icon": "media/vertical-tabs.svg"
        }
      ]
    },
    "views": {
      "vertical-tabs-activitybar": [
        {
          "id": "verticalTabs.launcher",
          "name": "Vertical Tabs",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verticalTabs.launcher",
        "when": "!verticalTabs.visible",
        "contents": "[Show](command:verticalTabs.open)"
      },
      {
        "view": "verticalTabs.launcher",
        "when": "verticalTabs.visible",
        "contents": "[Hide](command:verticalTabs.close)"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "npm run check-types && node scripts/build.mjs",
    "check-types": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "npm run compile --silent && node scripts/run-integration-tests.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "package": "node scripts/package.mjs",
    "check:vsix": "node scripts/check-vsix.mjs",
    "verify": "npm run compile && npm test && npm run package && npm run check:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "glob": "^11.0.2",
    "mocha": "^11.2.2",
    "typescript": "^5.8.3",
    "yauzl": "^3.4.0"
  }
}
